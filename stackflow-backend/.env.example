DB_URI=mongodb://127.0.0.1:27017/stackflow
PORT=5000
FRONTEND_URL=http://localhost:5173
# Replace these placeholders with two DIFFERENT randomly generated 32+ character values.
ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-characters
NODE_ENV=development
# Direct local traffic: 0. Render: 1 trusted hop; verify before increasing.
TRUST_PROXY=0
# Production uses service env vars (not .env), an Atlas mongodb+srv URI with
# an explicit application database, and exact HTTPS FRONTEND_URL origins.
